{
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "minimax_h3_fl2va_pruned_int8_convrot.safetensors",
      "weight_dtype": "default"
    },
    "_meta": {
      "title": "Load MiniMax H3 Diffusion Model (FL2VA, pruned INT8, ~19.5GB on disk)"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "type": "minimax",
      "device": "default"
    },
    "_meta": {
      "title": "Load H3 Text Encoder (Qwen3-VL-32B, NVFP4 AWQ, ~14.6GB on disk)"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_video_vae_fp16.safetensors"
    },
    "_meta": {
      "title": "Load Video VAE"
    }
  },
  "4": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_audio_vae_fp32.safetensors"
    },
    "_meta": {
      "title": "Load Audio VAE"
    }
  },
  "5": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "i2v_source_image.png"
    },
    "_meta": {
      "title": "Load Image -> first_frame (I2V mode). Delete this node's link on node 7 for pure text-to-video."
    }
  },
  "6": {
    "class_type": "ResolutionSelector",
    "inputs": {
      "aspect_ratio": "16:9 (Widescreen)",
      "megapixels": 0.5,
      "multiple": 32
    },
    "_meta": {
      "title": "Resolution Selector -> 960x544 (RTX 3060 12GB sweet spot)"
    }
  },
  "7": {
    "class_type": "MiniMaxH3ImageToVideo",
    "inputs": {
      "clip": ["2", 0],
      "vae": ["3", 0],
      "first_frame": ["5", 0],
      "prompt": "A single studio product shot of a matte-ceramic pour-over coffee dripper on a warm oak wood counter, soft window light from the left, steam rising gently from a glass carafe below it.\nSHOT 1 [0.0s-2.5s]: The scene opens exactly on the source image; the camera performs a slow, steady push-in as the steam curls upward and catches the warm light, a few coffee droplets fall from the dripper's spout.\nSHOT 2 [2.5s-5.0s]: The camera continues a smooth orbit to the right, revealing whole coffee beans scattered softly out of focus in the foreground; light flares gently across the ceramic glaze.\nSHOT 3 [5.0s-7.29s]: Slow settle to a static hero angle as the steam thins out and the shot holds, warm and inviting.\nAudio: soft ambient cafe room tone, a gentle trickle of coffee dripping, a faint ceramic clink at 2.5s, warm acoustic guitar underscore fading in slowly, no dialogue.",
      "width": ["6", 0],
      "height": ["6", 1],
      "length": 175
    },
    "_meta": {
      "title": "MiniMax H3 T2V/I2V (fl2va) -- length=175 frames @24fps = 7.29s, snapped to 17k+5 grid"
    }
  },
  "8": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": 908741235
    },
    "_meta": {
      "title": "Random Noise"
    }
  },
  "9": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "res_multistep"
    },
    "_meta": {
      "title": "Sampler Select (res_multistep -- required for MiniMax H3 audio+video joint sampling)"
    }
  },
  "10": {
    "class_type": "BasicScheduler",
    "inputs": {
      "model": ["1", 0],
      "scheduler": "simple",
      "steps": 20,
      "denoise": 1.0
    },
    "_meta": {
      "title": "Basic Scheduler"
    }
  },
  "11": {
    "class_type": "BasicGuider",
    "inputs": {
      "model": ["1", 0],
      "conditioning": ["7", 0]
    },
    "_meta": {
      "title": "Basic Guider"
    }
  },
  "12": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["8", 0],
      "guider": ["11", 0],
      "sampler": ["9", 0],
      "sigmas": ["10", 0],
      "latent_image": ["7", 1]
    },
    "_meta": {
      "title": "Sampler Custom Advanced"
    }
  },
  "13": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["12", 0],
      "vae": ["3", 0]
    },
    "_meta": {
      "title": "VAE Decode (video frames)"
    }
  },
  "14": {
    "class_type": "VAEDecodeAudio",
    "inputs": {
      "samples": ["12", 0],
      "vae": ["4", 0]
    },
    "_meta": {
      "title": "VAE Decode (stereo audio)"
    }
  },
  "15": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["13", 0],
      "audio": ["14", 0],
      "fps": 24,
      "bit_depth": 8
    },
    "_meta": {
      "title": "Create Video (mux frames + audio)"
    }
  },
  "16": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["15", 0],
      "filename_prefix": "video/MiniMax_H3_RTX3060",
      "format": "mp4",
      "codec": "h264"
    },
    "_meta": {
      "title": "Save Video"
    }
  }
}
