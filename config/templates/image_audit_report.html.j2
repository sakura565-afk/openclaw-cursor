<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Image Audit — {{ report.site }} ({{ report.finished_at }})</title>
  <link rel="stylesheet" href="assets/site.css">
</head>
<body>
<header class="hero">
  <h1>Image Audit Report</h1>
  <p class="subtitle">
    <strong>{{ site_name }}</strong> ({{ report.site }})
    &middot; run {{ report.finished_at or report.started_at }}
    {% if report.run_id %}&middot; run #{{ report.run_id }}{% endif %}
  </p>
  <div class="cards">
    <div class="card"><span class="num">{{ report.pages_crawled }}</span><span class="lbl">pages</span></div>
    <div class="card"><span class="num">{{ report.images_total }}</span><span class="lbl">images</span></div>
    <div class="card"><span class="num">{{ report.issues_total }}</span><span class="lbl">issues</span></div>
    <div class="card sev-critical"><span class="num">{{ report.severity_counts.get('critical', 0) }}</span><span class="lbl">critical</span></div>
    <div class="card sev-major"><span class="num">{{ report.severity_counts.get('major', 0) }}</span><span class="lbl">major</span></div>
    <div class="card sev-minor"><span class="num">{{ report.severity_counts.get('minor', 0) }}</span><span class="lbl">minor</span></div>
  </div>
</header>

<main>
  <section id="issue-types">
    <h2>Issues by type (site-wide)</h2>
    <table class="data">
      <thead><tr><th>Issue type</th><th>Severity</th><th class="num-col">Count</th><th>Recommendation</th></tr></thead>
      <tbody>
      {% for row in issue_type_rows %}
        <tr>
          <td><code>{{ row.type }}</code></td>
          <td><span class="badge sev-{{ row.severity }}">{{ row.severity }}</span></td>
          <td class="num-col">{{ row.count }}</td>
          <td>
            {{ row.recommendation }}
            {% if row.url %}<br><a href="{{ row.url }}" rel="noopener" target="_blank">reference &rarr;</a>{% endif %}
          </td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </section>

  <section id="worst-offenders">
    <h2>Top {{ worst_offenders|length }} worst offenders</h2>
    <table class="data">
      <thead><tr><th>#</th><th>Page</th><th class="num-col">Images</th><th class="num-col">Issues</th><th class="num-col">Critical</th><th class="num-col">Major</th><th class="num-col">Minor</th></tr></thead>
      <tbody>
      {% for page in worst_offenders %}
        <tr>
          <td>{{ loop.index }}</td>
          <td><a href="{{ page.url }}" rel="noopener" target="_blank">{{ page.url }}</a></td>
          <td class="num-col">{{ page.images }}</td>
          <td class="num-col">{{ page.issues }}</td>
          <td class="num-col">{{ page.critical }}</td>
          <td class="num-col">{{ page.major }}</td>
          <td class="num-col">{{ page.minor }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </section>

  <section id="per-page">
    <h2>Per-page breakdown</h2>
    <p class="hint">Click a column header to sort.</p>
    <table class="data sortable" id="page-table">
      <thead>
        <tr>
          <th data-type="text">Page</th>
          <th data-type="num" class="num-col">Images</th>
          <th data-type="num" class="num-col">Issues</th>
          <th data-type="num" class="num-col">Critical</th>
          <th data-type="num" class="num-col">Major</th>
          <th data-type="num" class="num-col">Minor</th>
        </tr>
      </thead>
      <tbody>
      {% for page in per_page %}
        <tr>
          <td><a href="{{ page.url }}" rel="noopener" target="_blank">{{ page.url }}</a></td>
          <td class="num-col">{{ page.images }}</td>
          <td class="num-col">{{ page.issues }}</td>
          <td class="num-col">{{ page.critical }}</td>
          <td class="num-col">{{ page.major }}</td>
          <td class="num-col">{{ page.minor }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </section>

  <section id="recommendations">
    <h2>Recommendations</h2>
    <ul class="reco-list">
    {% for row in issue_type_rows if row.count > 0 %}
      <li>
        <span class="badge sev-{{ row.severity }}">{{ row.severity }}</span>
        <strong>{{ row.type }}</strong> ({{ row.count }}) — {{ row.recommendation }}
        {% if row.url %}<a href="{{ row.url }}" rel="noopener" target="_blank">reference</a>{% endif %}
      </li>
    {% else %}
      <li>No issues found. Nice work!</li>
    {% endfor %}
    </ul>
  </section>

  <footer class="notes">
    <h3>Known limitations</h3>
    <ul>
      <li>JS-rendered images are not detected (no browser execution).</li>
      <li>File sizes come from HTTP HEAD / ranged GET headers, not full downloads.</li>
      <li>"Above the fold" is approximated by DOM order, not real layout.</li>
    </ul>
    <p class="generated">Generated by OpenClawImageAuditBot/1.0 on {{ generated_at }}.</p>
  </footer>
</main>

<script>
(function () {
  document.querySelectorAll('table.sortable').forEach(function (table) {
    var headers = table.querySelectorAll('thead th');
    headers.forEach(function (th, idx) {
      th.style.cursor = 'pointer';
      var asc = true;
      th.addEventListener('click', function () {
        var tbody = table.querySelector('tbody');
        var rows = Array.prototype.slice.call(tbody.querySelectorAll('tr'));
        var type = th.getAttribute('data-type') || 'text';
        rows.sort(function (a, b) {
          var x = a.children[idx].textContent.trim();
          var y = b.children[idx].textContent.trim();
          if (type === 'num') { return (parseFloat(x) || 0) - (parseFloat(y) || 0); }
          return x.localeCompare(y);
        });
        if (!asc) { rows.reverse(); }
        asc = !asc;
        rows.forEach(function (r) { tbody.appendChild(r); });
      });
    });
  });
})();
</script>
</body>
</html>
